# Seeder-402 Configuration (never commit actual values)
DATABASE_URL=/data/leases.db
STORE=/data/corestore
CONTROL_SOCKET=/data/ctrl/peer.sock
PEER_SOCKET=/data/ctrl/peer.sock
CONTROL_PORT=7001

# Network configuration
NETWORK=eip155:84532
PAY_TO=0xYOUR_PAYMENT_ADDRESS_HERE
FACILITATOR_URL=https://x402.org/facilitator

# Security
LEASE_SECRET=YOUR_JWT_SECRET_HERE
PEER_KEY=YOUR_PEER_KEY_HERE

# Storage
STORE_PATH=/var/lib/seeder-402/corestore
DB_PATH=/var/lib/seeder-402/seeder.db

# Pricing
MAX_KEYS=200
MAX_BYTES_PER_KEY=52428800
MAX_BODY_BYTES=52428800
PRICE_SEED_USD=0.10
PRICE_PIN_USD=0.20
PRICE_HOUSE_USD=0.50
PRICE_STATUS_USD=0.01

# Operational
KILL_SWITCH=0